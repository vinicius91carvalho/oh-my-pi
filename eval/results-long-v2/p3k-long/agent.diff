+/**
+ * The Greenhouse run that reported the bug (2026-08-28): the candidate had no
+ * work countries on file, and in one case the caller passed no posting at
+ * all - yet the answer was a positive, a claim with nothing behind it. With
+ * no evidence the negative is the only answer, in both of those shapes.
+ */
+describe("conservativeDefaultAnswer: authorization with no evidence", () => {
+  const NO_EVIDENCE =
+    "Are you legally authorized to work in the country where the job is located?";
+
+  it("answers no when the caller passed no posting at all", () => {
+    const d = conservativeDefaultAnswer(NO_EVIDENCE);
+    expect(d).not.toBeNull();
+    expect(d!.kind).toBe("boolean");
+    expect(d!.answer).toMatch(/^No/);
+    expect(resolveBooleanAnswer(d!.answer)).toBe("no");
+  });
+
+  it("answers no when the candidate has no work countries on file", () => {
+    const d = conservativeDefaultAnswer(NO_EVIDENCE, {
+      location: "San Francisco, CA, United States",
+      workCountries: [],
+    });
+    expect(d!.answer).toMatch(/^No/);
+    expect(resolveBooleanAnswer(d!.answer)).toBe("no");
+  });
+
+  it("answers no on a worldwide posting when no work countries are on file", () => {
+    // Worldwide reads as "works from home" only when the candidate has a home
+    // country on file; with none on file there is no country they are known
+    // to work in either.
+    const d = conservativeDefaultAnswer(NO_EVIDENCE, {
+      location: "Anywhere in the World",
+      remoteScope: "worldwide",
+      workCountries: [],
+    });
+    expect(d!.answer).toMatch(/^No/);
+    expect(resolveBooleanAnswer(d!.answer)).toBe("no");
+  });
+
+  it("explains the negative as missing evidence, not an unreadable posting", () => {
+    const d = conservativeDefaultAnswer(NO_EVIDENCE, {
+      location: "San Francisco, CA, United States",
+      workCountries: [],
+    });
+    expect(d!.answer).toMatch(/^No/);
+    expect(d!.why).toMatch(/no work countries/i);
+  });
+});
+
