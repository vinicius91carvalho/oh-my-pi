     expect(a?.answer).toMatch(/^No/);
   });
 });
+
+/**
+ * The bug report of 2026-08-27: the Greenhouse question "Are you legally
+ * authorized to work in the country where the job is located?" was answered
+ * "Yes - I am authorized to work where this role is based" for a candidate
+ * whose profile holds no work countries at all - and even when the caller
+ * passed no posting at all.
+
+ * No work countries on file means no evidence of where the candidate MAY
+ * work, not even where they live. The only truthful answer is the negative
+ * that claims nothing. Before the fix, `whereTheWorkIs` returned "yes" for
+ * an empty `workCountries` unconditionally, so every one of these cases
+ * produced the positive.
+ */
+describe("conservativeDefaultAnswer: authorization, no work countries on file", () => {
+  const ASKED =
+    "Are you legally authorized to work in the country where the job is located?";
+
+  it.each([
+    { location: "San Francisco, CA, United States", workCountries: [] },
+    { location: "Berlin/Remote", workCountries: [] },
+    { location: "Anywhere in the World", remoteScope: "worldwide", workCountries: [] },
+  ])("answers no for %j when the profile has no work countries", (job) => {
+    const d = conservativeDefaultAnswer(ASKED, job);
+    expect(d).not.toBeNull();
+    expect(d!.answer).toMatch(/^No/);
+    expect(resolveBooleanAnswer(d!.answer)).toBe("no");
+  });
+
+  it("answers no when the caller passes no posting at all", () => {
+    const d = conservativeDefaultAnswer(ASKED);
+    expect(d).not.toBeNull();
+    expect(d!.answer).toMatch(/^No/);
+    expect(resolveBooleanAnswer(d!.answer)).toBe("no");
+  });
+
+  it("keeps the positive when the profile does evidence the country", () => {
+    // The guard against the over-correction: an empty profile must not turn
+    // a candidate who CAN evidence the country into a negative.
+    const d = conservativeDefaultAnswer(ASKED, {
+      location: "São Paulo, Brazil",
+      workCountries: ["Brazil"],
+    });
+    expect(d!.answer).toMatch(/^Yes/);
+  });
+});
